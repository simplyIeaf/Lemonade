<?xml version="1.0" encoding="utf-8"?>
<!--
   Backups and device-to-device transfer (Android 12+): the Roblox sign-in, API key and saved
   accounts (roblox_auth) never leave this device, nor do the cached game lists or the sign-in
   browser's data. Settings, layout, plugins and the toolbox still move with the user.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="roblox_auth.xml" />
        <exclude domain="sharedpref" path="start_cache.xml" />
        <exclude domain="root" path="app_webview/" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="roblox_auth.xml" />
        <exclude domain="sharedpref" path="start_cache.xml" />
        <exclude domain="root" path="app_webview/" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
